--- a/SRT-SNES/Source/SRTTest.s
+++ b/SRT-SNES/Source/SRTTest.s
@@ -735,6 +735,109 @@
 
 	; Init done - enable screen
 	RW a8i16
+
+; Unmute the SNES audio: after reset the S-DSP has FLG bit 6 (MUTE) set, and
+; its mute output silences the console's amplifier - which also carries the
+; cartridge (MSU-1) audio. The other S-DSP registers start with random values
+; after power-on: a non-zero echo volume then plays the random echo buffer, a
+; click every EDL x 16 ms. So a small program is uploaded to the sound CPU
+; through the IPL boot ROM that first silences everything the S-DSP itself
+; could play (main and echo volume, echo feedback / enables / delay, noise,
+; pitch modulation, all voices keyed off), then clears MUTE (echo writes stay
+; off) and loops.   (a8 i16, any data bank)
+:	lda f:$002140		; IPL ready ($AA)
+	cmp #$AA
+	bne :-
+	lda #$00
+	sta f:$002142		; destination $0200
+	lda #$02
+	sta f:$002143
+	lda #$01
+	sta f:$002141		; non-zero: transfer
+	lda #$CC
+	sta f:$002140
+:	cmp f:$002140
+	bne :-
+	ldx #$0000
+SpcInitLoop:
+	lda f:SpcInitProg,x
+	sta f:$002141		; data byte
+	txa
+	sta f:$002140		; its index (low byte), echoed back when taken
+:	cmp f:$002140
+	bne :-
+	inx
+	cpx #(SpcInitProgEnd - SpcInitProg)
+	bne SpcInitLoop
+	lda #$00
+	sta f:$002142		; start at $0200
+	lda #$02
+	sta f:$002143
+	lda #$00
+	sta f:$002141		; zero: execute
+	txa
+	inc a			; last index + 2
+	sta f:$002140
+:	cmp f:$002140
+	bne :-
+	bra SpcInitDone
+SpcInitProg:			; mov $F2,#reg / mov $F3,#value pairs, then bra *
+	.byte $8F,$0C,$F2, $8F,$00,$F3	; MVOL L = 0
+	.byte $8F,$1C,$F2, $8F,$00,$F3	; MVOL R = 0
+	.byte $8F,$2C,$F2, $8F,$00,$F3	; EVOL L = 0
+	.byte $8F,$3C,$F2, $8F,$00,$F3	; EVOL R = 0
+	.byte $8F,$0D,$F2, $8F,$00,$F3	; EFB = 0
+	.byte $8F,$4D,$F2, $8F,$00,$F3	; EON = 0
+	.byte $8F,$7D,$F2, $8F,$00,$F3	; EDL = 0
+	.byte $8F,$3D,$F2, $8F,$00,$F3	; NON = 0
+	.byte $8F,$2D,$F2, $8F,$00,$F3	; PMON = 0
+	.byte $8F,$5C,$F2, $8F,$FF,$F3	; KOF = all voices off
+	.byte $8F,$6C,$F2, $8F,$20,$F3	; FLG: unmuted, echo writes off
+	.byte $2F,$FE			; bra *
+SpcInitProgEnd:
+SpcInitDone:
+
+	; MSU-1 background music: if an MSU-1 is present ("S-MSU1" at $2002),
+	; play track 1 (<rom>-1.pcm) at full volume, repeating
+	lda f:$002002
+	cmp #$53			; 'S'
+	bne @NoMSU
+	lda f:$002003
+	cmp #$2D			; '-'
+	bne @NoMSU
+	lda #$FF
+	sta f:$002006		; volume
+	phx
+	phy
+	ldx #$0020			; retries (firmware may still be starting up)
+@MSURequest:
+	lda #$01
+	sta f:$002004		; track number, low byte
+	lda #$00
+	sta f:$002005		; track number, high byte (starts loading the track)
+@MSUWait:
+	lda f:$002000
+	bit #$40			; audio busy
+	bne @MSUWait
+	bit #$08			; audio error (track missing / not ready)
+	beq @MSUPlay
+	ldy #$0000			; ~0.4s delay, then ask again
+@MSUDelay:
+	nop
+	nop
+	dey
+	bne @MSUDelay
+	dex
+	bne @MSURequest
+	bra @MSUDone
+@MSUPlay:
+	lda #$03			; play + repeat
+	sta f:$002007
+@MSUDone:
+	ply
+	plx
+@NoMSU:
+
 	lda #inidisp(ON, DISP_BRIGHTNESS_MAX)
 	sta INIDISP
 
